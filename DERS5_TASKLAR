-- TASK 1
SELECT FIRST_NAME, LAST_NAME, HIRE_DATE,
    CASE
        WHEN HIRE_DATE < TO_DATE('2003-01-01', 'YYYY-MM-DD') THEN 'Veteran'
        WHEN HIRE_DATE BETWEEN TO_DATE('2003-01-01', 'YYYY-MM-DD') AND
                                TO_DATE('2006-12-31', 'YYYY-MM-DD') THEN 'Tecrubeli'
        WHEN HIRE_DATE >= TO_DATE('2007-01-01', 'YYYY-MM-DD') THEN 'Yeni'
    END AS STAJ_QRUPU
FROM HR.EMPLOYEES;

-- TASK 1(QISA)
SELECT FIRST_NAME, LAST_NAME, HIRE_DATE,
    CASE
        WHEN EXTRACT(YEAR FROM HIRE_DATE) < 2003 THEN 'Veteran'
        WHEN EXTRACT(YEAR FROM HIRE_DATE) BETWEEN 2003 AND 2006 THEN 'Tecrubeli'
        WHEN EXTRACT(YEAR FROM HIRE_DATE) > 2006 THEN 'Yeni'
    END AS STAJ_QRUPU
FROM HR.EMPLOYEES;

-- TASK 2
SELECT DEPARTMENT_ID, DEPARTMENT_NAME,
    CASE DEPARTMENT_NAME
        WHEN 'Administration' THEN 'Idareetme'
        WHEN 'Marketing' THEN 'Marketinq'
        WHEN 'Purchasing' THEN 'Satinalma'
        WHEN 'Human Resources' THEN 'Insan Resurslari'
        ELSE 'Diger sobe'
    END AS SOBE_AZ
FROM HR.DEPARTMENTS;

-- TASK 3(CASE WHEN)
SELECT FIRST_NAME, DEPARTMENT_ID,
    CASE
        WHEN DEPARTMENT_ID IS NULL THEN 'SOBE TEYIN OLUNMAYIB'
        ELSE 'SOBE VAR'
    END AS SOBE_STATUSU
FROM HR.EMPLOYEES;

-- TASK 3(NVL2)
SELECT FIRST_NAME, DEPARTMENT_ID,
       NVL2(DEPARTMENT_ID, 'SOBE VAR', 'SOBE TEYIN OLUNMAYIB') AS SOBE_STATUSU
FROM HR.EMPLOYEES;

-- TASK 4
SELECT JOB_ID, JOB_TITLE,
    CASE
        WHEN JOB_ID IN ('AD_PRES', 'AD_VP', 'FI_MGR', 'AC_MGR') THEN 'ALI REHBERLIK'
        WHEN JOB_ID IN ('IT_PROG', 'SA_REP', 'FI_ACCOUNT') THEN 'ESAS MUTEXESSIS'
        WHEN JOB_ID IN ('ST_CLERK', 'SH_CLERK', 'PU_CLERK') THEN 'OPERATIV ISCI'
        ELSE 'DIGER'
    END AS KATEQORIYA
FROM HR.JOBS;

-- TASK 5
SELECT FIRST_NAME, DEPARTMENT_ID, SALARY,
    CASE DEPARTMENT_ID
        WHEN 50 THEN SALARY * 0.08
        WHEN 30 THEN SALARY * 0.12
        WHEN 100 THEN 400
        ELSE SALARY * 0.04
    END AS MUAVINET
FROM HR.EMPLOYEES
ORDER BY MUAVINET DESC;

-- TASK 6
SELECT FIRST_NAME, COMMISSION_PCT,
       CASE
           WHEN COMMISSION_PCT IS NULL THEN 'Yoxdur' -- = NULL YERINE IS NULL
           WHEN COMMISSION_PCT > 0.25  THEN 'Yuksek komissiya' -- YERINI DEYISMELIYIK
           ELSE 'Normal komissiya'
       END AS "Komissiya novu" -- '' YOX "" ISLET
FROM HR.EMPLOYEES;

-- TASK 7***
SELECT FIRST_NAME, PHONE_NUMBER, SALARY,
    CASE
        WHEN PHONE_NUMBER LIKE '515%' THEN 'DAXILI XETT'
        WHEN SALARY >= 10000 THEN 'YUKSEK MAASLI'
        WHEN COMMISSION_PCT IS NOT NULL THEN 'SATIS KOMANDASI'
        ELSE 'STANDART ISCI'
    END AS KATEQORIYA
FROM HR.EMPLOYEES;

-- TASK 8(NVL2)
SELECT FIRST_NAME, SALARY, COMMISSION_PCT,
       NVL2(COMMISSION_PCT, SALARY * COMMISSION_PCT * 3, 0) AS RUBLUK_BONUS,
       NVL2(COMMISSION_PCT, SALARY * 3 + SALARY * COMMISSION_PCT * 3, SALARY * 3) AS RUBLUK_UMUMI
FROM HR.EMPLOYEES;

-- TASK 9
SELECT E.FIRST_NAME, J.JOB_TITLE, E.SALARY, J.MIN_SALARY, J.MAX_SALARY,
    CASE
        WHEN E.SALARY = J.MAX_SALARY THEN 'LIMITE CATIB'
        WHEN J.MAX_SALARY - E.SALARY <= 2000 THEN 'LIMITE COX YAXIN'
        WHEN E.SALARY < J.MIN_SALARY + 1000 THEN 'BASLANGIC SEVIYYEDE'
        ELSE 'ORTA ARALIQDA'
    END AS MAAS_VEZIYYETI
FROM HR.EMPLOYEES E
JOIN HR.JOBS J
ON E.JOB_ID = J.JOB_ID;

-- TASK 10
SELECT E.FIRST_NAME, E.LAST_NAME,
       NVL2(D.MANAGER_ID, 'REHBERI VAR', 'REHBERI YOXDUR') AS MENECER_STATUSU,
       CASE
           WHEN D.DEPARTMENT_ID IS NULL THEN 'TEYIN EDILMEYIB'
           WHEN L.COUNTRY_ID = 'US' THEN 'ABS OFISI'
           ELSE 'BEYNELXALQ OFIS'
        END AS REGION
FROM HR.EMPLOYEES E
LEFT JOIN HR.DEPARTMENTS D
ON E.DEPARTMENT_ID = D.DEPARTMENT_ID
LEFT JOIN HR.LOCATIONS L
ON D.LOCATION_ID = L.LOCATION_ID;

-- TASK 1
SELECT E.FIRST_NAME AS ISCI_ADI, E.JOB_ID AS ISCI_VEZIFESI,
       M.FIRST_NAME AS MENECER_ADI, M.JOB_ID AS MENECER_VEZIFESI
FROM HR.EMPLOYEES E
JOIN HR.EMPLOYEES M
ON E.MANAGER_ID = M.EMPLOYEE_ID;

-- TASK 2
SELECT E.FIRST_NAME, E.LAST_NAME,
       NVL(M.FIRST_NAME, 'YOXDUR') AS MENECER_ADI,
       NVL(M.LAST_NAME, 'YOXDUR') AS MENECER_SOYADI
FROM HR.EMPLOYEES E
LEFT JOIN HR.EMPLOYEES M
ON E.MANAGER_ID = M.EMPLOYEE_ID;

-- TASK 3
SELECT DEPARTMENT_ID, DEPARTMENT_NAME, LOCATION_ID
FROM HR.DEPARTMENTS
WHERE LOCATION_ID IN (SELECT COUNTRY_ID
                     FROM HR.LOCATIONS
                     WHERE COUNTRY_ID = 'UK');

-- TASK 4
SELECT E.FIRST_NAME, E.LAST_NAME, E.SALARY
FROM HR.EMPLOYEES E
JOIN HR.EMPLOYEES M
ON M.EMPLOYEE_ID = E.MANAGER_ID
WHERE M.FIRST_NAME = 'Neena' AND M.LAST_NAME = 'Kochhar'

-- TASK 5
SELECT E.FIRST_NAME, E.LAST_NAME,
       E.HIRE_DATE AS ISCI_TARIX,
       M.FIRST_NAME AS MENECER_ADI,
       M.HIRE_DATE AS MENECER_TARIX
FROM HR.EMPLOYEES E
JOIN HR.EMPLOYEES M
ON E.MANAGER_ID = M.EMPLOYEE_ID
WHERE E.HIRE_DATE < M.HIRE_DATE;

-- TASK 6
SELECT E.FIRST_NAME, E.LAST_NAME, E.JOB_ID,
       M.FIRST_NAME AS MENECER_ADI,
       M.LAST_NAME AS MENECER_SOYADI
FROM HR.EMPLOYEES E
JOIN HR.EMPLOYEES M
ON E.MANAGER_ID = M.EMPLOYEE_ID
WHERE E.JOB_ID = M.JOB_ID;

-- TASK 7
SELECT FIRST_NAME, LAST_NAME,
       JOB_ID, SALARY
FROM HR.EMPLOYEES
WHERE JOB_ID IN (SELECT JOB_ID
                 FROM HR.JOBS
                 WHERE MAX_SALARY > 15000)

-- TASK 8
SELECT FIRST_NAME, SALARY
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID IN (SELECT DEPARTMENT_ID -- IN OLMALIDI, LOCATION OLMAMALIDI
                       FROM HR.DEPARTMENTS
                       WHERE DEPARTMENT_NAME IN ('IT', 'Finance')); -- IT BOYUKLE

-- TASK 9
SELECT EMPLOYEE_ID, FIRST_NAME, LAST_NAME
FROM HR.EMPLOYEES
WHERE EMPLOYEE_ID NOT IN (
    SELECT MANAGER_ID
    FROM HR.EMPLOYEES
    WHERE MANAGER_ID IS NOT NULL);

-- TASK 10
SELECT M.FIRST_NAME AS MENECER_ADI,
       M.LAST_NAME AS MENECER_SOYADI,
       MAX(E.SALARY) AS MAX_TABE_MAASI,
       MIN(E.SALARY) AS MIN_TABE_MAASI
FROM HR.EMPLOYEES M
JOIN HR.EMPLOYEES E
ON M.EMPLOYEE_ID = E.MANAGER_ID
GROUP BY M.EMPLOYEE_ID, M.FIRST_NAME, M.LAST_NAME
HAVING AVG(E.SALARY) > 7000
ORDER BY MAX_TABE_MAASI DESC;
